+def trailing_mean(features: np.ndarray, window: int) -> np.ndarray:
+    """Causal rolling mean: each row uses only itself and earlier rows."""
+    if window <= 0:
+        raise ValueError("window must be positive")
+    x = np.asarray(features, dtype=np.float64)
+    if x.ndim != 2:
+        raise ValueError("features must be a 2-D array")
+    cumulative = np.vstack([np.zeros((1, x.shape[1])), np.cumsum(x, axis=0)])
+    starts = np.maximum(np.arange(len(x)) - window + 1, 0)
+    totals = cumulative[np.arange(1, len(x) + 1)] - cumulative[starts]
+    lengths = (np.arange(len(x)) - starts + 1)[:, None]
+    return totals / lengths
+
