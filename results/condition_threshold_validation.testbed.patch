+def _fit_spatial_baseline(lidar_frames: list[np.ndarray]) -> dict[str, object]:
+    if not lidar_frames:
+        return {
+            "x_sector_edges": None,
+            "y_sector_edges": None,
+            "sector_point_counts": None,
+            "sector_z_means": None,
+        }
+
+    all_points = np.vstack(lidar_frames)
+    x_edges = tuple(float(value) for value in np.quantile(all_points[:, 0], (1 / 3, 2 / 3)))
+    y_edges = tuple(float(value) for value in np.quantile(all_points[:, 1], (1 / 3, 2 / 3)))
+    if not (x_edges[0] < x_edges[1] and y_edges[0] < y_edges[1]):
+        return {
+            "x_sector_edges": None,
+            "y_sector_edges": None,
+            "sector_point_counts": None,
+            "sector_z_means": None,
+        }
+
+    frame_counts: list[np.ndarray] = []
+    frame_z_means: list[np.ndarray] = []
+    for lidar in lidar_frames:
+        counts, z_means = _sector_values(lidar, x_edges, y_edges)
+        frame_counts.append(counts)
+        frame_z_means.append(z_means)
+
+    count_baseline = np.median(np.vstack(frame_counts), axis=0)
+    z_matrix = np.vstack(frame_z_means)
+    z_baseline = np.asarray([
+        np.median(column[np.isfinite(column)])
+        if np.any(np.isfinite(column)) else np.nan
+        for column in z_matrix.T
+    ])
+    return {
+        "x_sector_edges": x_edges,
+        "y_sector_edges": y_edges,
+        "sector_point_counts": tuple(float(value) for value in count_baseline),
+        "sector_z_means": tuple(float(value) for value in z_baseline),
+    }
+
+
+def _spatial_baseline_available(baseline: ObservationBaseline) -> bool:
+    return bool(
+        baseline.x_sector_edges is not None
+        and baseline.y_sector_edges is not None
+        and baseline.sector_point_counts is not None
+        and baseline.sector_z_means is not None
+        and len(baseline.x_sector_edges) == 2
+        and len(baseline.y_sector_edges) == 2
+        and len(baseline.sector_point_counts) == len(_SECTOR_IDS)
+        and len(baseline.sector_z_means) == len(_SECTOR_IDS)
+    )
+
+
+def _sector_values(
+    lidar: np.ndarray,
+    x_edges: tuple[float, float],
+    y_edges: tuple[float, float],
+) -> tuple[np.ndarray, np.ndarray]:
+    x_bins = np.digitize(lidar[:, 0], x_edges)
+    y_bins = np.digitize(lidar[:, 1], y_edges)
+    counts = np.zeros(len(_SECTOR_IDS), dtype=np.float64)
+    z_means = np.full(len(_SECTOR_IDS), np.nan, dtype=np.float64)
+    for index, (x_index, y_index) in enumerate(_SECTOR_IDS):
+        selected = (x_bins == x_index) & (y_bins == y_index)
+        counts[index] = float(np.sum(selected))
+        if np.any(selected):
+            z_means[index] = float(np.mean(lidar[selected, 2]))
+    return counts, z_means
+
+
+def _empty_spatial_statistics() -> dict[str, float]:
+    return {
+        **{name: 0.0 for name in _SECTOR_COUNT_NAMES},
+        **{name: 0.0 for name in _SECTOR_Z_NAMES},
+        **{name: 0.0 for name in _SECTOR_ORDER_NAMES},
+        "sector_count_ratio_min": 0.0,
+        "sector_count_ratio_std": 0.0,
+        "sector_depleted_ratio": 0.0,
+    }
+
+
+def _spatial_statistics(
+    lidar: np.ndarray,
+    baseline: ObservationBaseline,
+) -> dict[str, float]:
+    assert baseline.x_sector_edges is not None
+    assert baseline.y_sector_edges is not None
+    assert baseline.sector_point_counts is not None
+    assert baseline.sector_z_means is not None
+    counts, z_means = _sector_values(
+        lidar, baseline.x_sector_edges, baseline.y_sector_edges
+    )
+    baseline_counts = np.asarray(baseline.sector_point_counts)
+    count_ratios = np.divide(
+        counts,
+        baseline_counts,
+        out=np.zeros_like(counts),
+        where=baseline_counts > 0.0,
+    )
+    baseline_z = np.asarray(baseline.sector_z_means)
+    z_deltas = np.subtract(
+        z_means,
+        baseline_z,
+        out=np.zeros_like(z_means),
+        where=np.isfinite(z_means) & np.isfinite(baseline_z),
+    )
+    ordered_ratios = np.sort(count_ratios)
+    return {
+        **dict(zip(_SECTOR_COUNT_NAMES, count_ratios.astype(float))),
+        **dict(zip(_SECTOR_Z_NAMES, z_deltas.astype(float))),
+        **dict(zip(_SECTOR_ORDER_NAMES, ordered_ratios.astype(float))),
+        "sector_count_ratio_min": float(np.min(count_ratios)),
+        "sector_count_ratio_std": float(np.std(count_ratios)),
+        "sector_depleted_ratio": float(np.mean(count_ratios < 0.75)),
+    }
